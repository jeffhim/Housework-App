<script>
    // Create manifest with your custom icon
    const manifestData = {
        "name": "家務記錄 App",
        "short_name": "家務記錄",
        "description": "安全的家務記錄和結算應用程式",
        "start_url": "./",
        "display": "standalone",
        "background_color": "#ffffff",
        "theme_color": "#4CAF50",
        "orientation": "portrait",
        "scope": "./",
        "icons": [
            {
                "src": "./icon-192.png",
                "sizes": "192x192",
                "type": "image/png"
            },
            {
                "src": "./icon-192.png",
                "sizes": "512x512",
                "type": "image/png"
            },
            {
                "src": "./icon-192.png",
                "sizes": "180x180",
                "type": "image/png"
            }
        ]
    };

    // Register manifest
    const manifestBlob = new Blob([JSON.stringify(manifestData)], { type: 'application/json' });
    const manifestURL = URL.createObjectURL(manifestBlob);
    
    const link = document.createElement('link');
    link.rel = 'manifest';
    link.href = manifestURL;
    document.head.appendChild(link);
</script>
